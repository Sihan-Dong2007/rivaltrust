// src/api/ollama.js
// ─────────────────────────────────────────────────────────────
// All LLM calls go through this file.
// Three roles use different models:
//   RIVAL      → llama3   (strong argumentative reasoning)
//   FACILITATOR → mistral  (empathetic, meta-cognitive)
//   ROUTER     → mistral  (fast, lightweight decision-making)
// ─────────────────────────────────────────────────────────────

const OLLAMA_BASE = "http://localhost:11434/api/chat";

export const MODELS = {
  rival: "llama3",
  facilitator: "mistral",
  router: "mistral",
};

/**
 * Core call to Ollama.
 * @param {string} model        - Ollama model name
 * @param {string} systemPrompt - System instruction for this role
 * @param {Array}  messages     - [{role, content}] conversation history
 * @returns {string}            - Model's text response
 */
export async function callOllama(model, systemPrompt, messages) {
  const response = await fetch(OLLAMA_BASE, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      model,
      stream: false,
      messages: [
        { role: "system", content: systemPrompt },
        ...messages,
      ],
    }),
  });

  if (!response.ok) {
    const err = await response.text();
    throw new Error(`Ollama error (${response.status}): ${err}`);
  }

  const data = await response.json();
  return data.message?.content || "";
}

/**
 * Parse JSON from LLM output safely.
 * LLMs sometimes wrap JSON in ```json fences.
 */
export function parseJSON(raw, fallback) {
  try {
    const cleaned = raw.replace(/```json|```/g, "").trim();
    return JSON.parse(cleaned);
  } catch {
    return fallback;
  }
}
